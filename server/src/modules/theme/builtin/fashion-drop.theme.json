      },
      {
        "icon": "verified",
        "title": "Curated Quality",
        "text": "Selected for daily wear"
      },
      {
        "icon": "offers",
        "title": "Drop Offers",
        "text": "Limited campaign deals"
      },
      {
        "icon": "support",
        "title": "Easy Returns",
        "text": "Simple return flow"
      }
