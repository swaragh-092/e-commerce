    "promoBanners": [
      {
        "kicker": "Limited Offer",
        "title": "Weekend Wardrobe Refresh",
        "subtitle": "Save on selected styles for a short time.",
        "ctaText": "Shop Sale",
        "link": "/products?onSale=true",
