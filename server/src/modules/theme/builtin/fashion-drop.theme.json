            "role": "Verified buyer"
          },
          {
            "title": "Feels boutique",
            "text": "The storefront gives every drop a point of view.",
            "author": "Leah K.",
            "role": "Verified buyer"
          }
        ]
      },
      {
        "id": "newsletter",
        "type": "newsletter-signup",
        "enabled": true,
        "title": "Get The Next Drop First",
        "subtitle": "Early access to edits, offers, and limited arrivals.",
        "ctaText": "Join The List",
        "variant": "banner"
      }
