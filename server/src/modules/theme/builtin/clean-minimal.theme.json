{
  "schemaVersion": 3,
  "meta": {
    "slug": "clean-minimal",
    "name": "Clean Minimal",
    "version": "1.0.0",
    "author": "Platform Templates",
    "description": "Bright, simple, and product-first. Monochrome with blue accents for a modern distraction-free catalog.",
    "category": "general",
    "tags": [
      "light",
      "minimal",
      "clean",
      "monochrome",
      "blue"
    ],
    "previewImage": "data:image/svg+xml;base64,",
    "bestFor": "Minimal catalogs, modern DTC stores, lifestyle products, and simple product-first shops."
  },
  "design": {
    "theme": {
      "mode": "light",
      "primaryColor": "#111827",
      "secondaryColor": "#2563eb",
      "backgroundColor": "#f8fafc",
      "surfaceColor": "#ffffff",
      "textColor": "#111827",
      "fontFamily": "Inter",
      "headingFont": "Inter",
      "headingWeight": "700",
      "bodyWeight": "400",
      "lineHeight": "1.6",
      "letterSpacing": "0px",
      "headingLetterSpacing": "-0.5px",
      "borderRadius": "8px",
      "headerStyle": "solid",
      "buttonStyle": "solid",
      "cardStyle": "outlined",
      "backgroundStyle": "solid"
    }
  },
  "layout": {
    "nav": {
      "sticky": true,
      "showCategoryBar": false
    },
    "footerStyle": {
      "bgColor": "#111827",
      "fgColor": "#f8fafc"
    },
    "announcementStyle": {
      "bgColor": "#2563eb",
      "fgColor": "#ffffff",
      "dismissible": true
    },
    "homepageSections": [
      {
        "id": "hero",
        "type": "hero-carousel",
        "enabled": true,
        "autoPlay": true,
        "interval": 6500,
        "variant": "overlay"
      },
      {
        "id": "featured",
        "type": "product-row",
        "enabled": true,
        "title": "Featured Essentials",
        "source": "featured",
        "dataSourceKey": "featured-products",
        "count": 8,
        "layout": "grid",
        "viewAllLink": "/products?featured=true"
      },
      {
        "id": "minimal-story",
        "type": "editorial-image-text",
        "enabled": true,
        "title": "Less Noise. More Product.",
        "subtitle": "A restrained flow for brands that want clarity, whitespace, and direct shopping.",
        "image": "https://images.unsplash.com/photo-1491933382434-500287f9b54b?auto=format&fit=crop&w=1200&q=80",
        "imagePosition": "right",
        "ctaText": "Shop Essentials",
        "ctaLink": "/products"
      },
      {
        "id": "categories",
        "type": "featured-collection-grid",
        "enabled": true,
        "title": "Simple Categories",
        "count": 6,
        "dynamic": true
      },
      {
        "id": "trust-badges",
        "type": "trust-badges",
        "enabled": true,
        "items": [
          {
            "title": "Clean Browsing",
            "text": "Product-first layout"
          },
          {
            "title": "Fast Checkout",
            "text": "Short path to cart"
          },
          {
            "title": "Mobile Ready",
            "text": "Compact sections"
          },
          {
            "title": "Easy Editing",
            "text": "Simple structure"
          }
        ]
      },
      {
        "id": "newsletter",
        "type": "newsletter-signup",
        "enabled": true,
        "title": "Quiet Updates",
        "subtitle": "New essentials and simple offers.",
        "ctaText": "Subscribe",
        "variant": "inline-form"
      }
    ]
  },
  "demoContent": {
    "announcementText": "New arrivals every week. Free returns within 30 days.",
    "heroSlides": [
      {
        "eyebrow": "Curated",
        "title": "Less Noise. Better Products.",
        "subtitle": "A clean shopping experience focused on quality over quantity.",
        "buttonText": "Browse All",
        "buttonLink": "/products",
        "secondaryButtonText": "New Arrivals",
        "secondaryButtonLink": "/products?sort=newest",
        "image": "https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=1800&q=80",
        "position": "center",
        "color": "#ffffff"
      },
      {
        "eyebrow": "Essentials",
        "title": "A Storefront That Gets Out Of The Way",
        "subtitle": "Perfect for catalogs where the product should do the talking.",
        "buttonText": "Shop Essentials",
        "buttonLink": "/products?featured=true",
        "image": "https://images.unsplash.com/photo-1523381210434-271e8be1f52b?auto=format&fit=crop&w=1800&q=80",
        "position": "center",
        "color": "#ffffff"
      }
    ],
    "valueProps": [
      {
        "icon": "fast",
        "title": "Quick Delivery",
        "text": "2-4 business days"
      },
      {
        "icon": "secure",
        "title": "Secure Checkout",
        "text": "Protected payments"
      },
      {
        "icon": "support",
        "title": "Helpful Support",
        "text": "Clear answers, fast"
      },
      {
        "icon": "verified",
        "title": "Quality Picks",
        "text": "Curated product range"
      }
    ],
    "promoBanners": [
      {
        "kicker": "Clean Sale",
        "title": "Essentials Under $50",
        "subtitle": "Simple offers for everyday shoppers.",
        "ctaText": "Shop Deals",
        "link": "/products?onSale=true",
        "color": "#eff6ff",
        "accentColor": "#2563eb"
      },
      {
        "kicker": "New",
        "title": "Minimal Looks, Maximum Utility",
        "subtitle": "Fresh arrivals with clean presentation.",
        "ctaText": "View New",
        "link": "/products?sort=newest",
        "color": "#f8fafc",
        "accentColor": "#111827"
      }
    ]
  },
  "capabilities": {
    "design": true,
    "layoutStyle": true,
    "homepageSections": true,
    "demoContent": true,
    "pageTemplates": true,
    "dataSources": true,
    "customCode": false,
    "componentStyles": true,
    "sectionPresets": true
  },
  "dataSources": [
    {
      "key": "featured-products",
      "type": "apiBuilder",
      "definition": {
        "name": "Clean Minimal Featured Products",
        "description": "Template-owned storefront endpoint for Clean Minimal product rows.",
        "isActive": true,
        "config": {
          "responseMode": "object",
          "includeMeta": true,
          "blocks": [
            {
              "key": "products",
              "resource": "products",
              "enabled": true,
              "mode": "filtered",
              "limit": 8,
              "fields": [
                "id",
                "name",
                "slug",
                "shortDescription",
                "price",
                "salePrice",
                "saleLabel",
                "avgRating",
                "reviewCount",
                "brandId",
                "createdAt"
              ],
              "filters": [
                {
                  "field": "isFeatured",
                  "operator": "equals",
                  "source": "static",
                  "value": true
                }
              ],
              "relations": [
                {
                  "key": "images",
                  "relation": "images",
                  "resource": "productImages",
                  "enabled": true,
                  "mode": "all",
                  "limit": 1,
                  "fields": [
                    "url",
                    "alt",
                    "isPrimary",
                    "sortOrder"
                  ],
                  "sortBy": "sortOrder",
                  "sortOrder": "ASC"
                }
              ],
              "sortBy": "createdAt",
              "sortOrder": "DESC"
            }
          ]
        }
      }
    }
  ],
  "pageTemplates": {
    "product": {
      "layout": "media-left-details-right",
      "showTrustBadges": false,
      "showRelatedProducts": true,
      "showRecentlyViewed": false,
      "showStickyAddToCart": true,
      "showBreadcrumbs": true
    },
    "collection": {
      "layout": "top-filter-wide-grid",
      "productsPerRow": 4,
      "filterLayout": "topbar",
      "showBreadcrumbs": true
    }
  },
  "componentStyles": {
    "productCard": {
      "variant": "minimal",
      "imageRatio": "4/3",
      "imageFit": "contain",
      "showBrand": false,
      "showCategory": true,
      "showRating": false,
      "showWishlist": false,
      "showSaleCountdown": false,
      "priceStyle": "regular",
      "badgeStyle": "minimal",
      "badgePosition": "top-right",
      "hoverEffect": "none",
      "radius": "small",
      "shadow": "none",
      "density": "comfortable"
    },
    "categoryCard": {
      "variant": "compact-chips",
      "imageRatio": "1/1",
      "imageFit": "cover",
      "titlePlacement": "below",
      "showSubtitle": false,
      "showProductCount": false,
      "hoverEffect": "none",
      "radius": "pill",
      "shadow": "none",
      "density": "compact"
    },
    "promoCard": {
      "variant": "banner-stack",
      "imagePlacement": "right",
      "titleSize": "medium",
      "ctaStyle": "text-link",
      "radius": "small",
      "shadow": "none"
    },
    "brandCard": {
      "variant": "logo-only",
      "hoverEffect": "none",
      "radius": "small",
      "shadow": "none"
    },
    "trustCard": {
      "variant": "icon-row",
      "titleSize": "small",
      "radius": "small",
      "shadow": "none"
    }
  },
  "sectionPresets": {
    "hero": {
      "type": "hero-carousel",
      "autoPlay": true,
      "interval": 6500,
      "variant": "overlay"
    },
    "productRow": {
      "type": "product-row",
      "title": "Featured Essentials",
      "source": "featured",
      "count": 8,
      "layout": "grid",
      "viewAllLink": "/products?featured=true"
    },
    "editorial": {
      "type": "editorial-image-text",
      "title": "Less Noise. More Product.",
      "subtitle": "A restrained flow for brands that want clarity, whitespace, and direct shopping.",
      "image": "https://images.unsplash.com/photo-1491933382434-500287f9b54b?auto=format&fit=crop&w=1200&q=80",
      "imagePosition": "right",
      "ctaText": "Shop Essentials",
      "ctaLink": "/products"
    },
    "categoryGrid": {
      "type": "featured-collection-grid",
      "title": "Simple Categories",
      "count": 6,
      "dynamic": true
    },
    "trust": {
      "type": "trust-badges",
      "items": [
        {
          "title": "Clean Browsing",
          "text": "Product-first layout"
        },
        {
          "title": "Fast Checkout",
          "text": "Short path to cart"
        },
        {
          "title": "Mobile Ready",
          "text": "Compact sections"
        },
        {
          "title": "Easy Editing",
          "text": "Simple structure"
        }
      ]
    },
    "newsletter": {
      "type": "newsletter-signup",
      "title": "Quiet Updates",
      "subtitle": "New essentials and simple offers.",
      "ctaText": "Subscribe",
      "variant": "inline-form"
    }
  }
}
