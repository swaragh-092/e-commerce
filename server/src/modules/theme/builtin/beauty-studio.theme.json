    ],
    "promoBanners": [
      {
        "kicker": "Bundle Save",
        "title": "Build Your Routine",
        "subtitle": "Cleanser, serum, moisturizer, and glow essentials.",
        "ctaText": "Shop Bundles",
        "link": "/products?featured=true",
        "color": "#ffe4e6",
        "accentColor": "#be185d"
