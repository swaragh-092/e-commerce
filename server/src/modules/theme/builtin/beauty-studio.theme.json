        "count": 8,
        "layout": "carousel",
        "viewAllLink": "/products?featured=true",
        "variant": "carousel"
      },
      {
        "id": "testimonials",
        "type": "testimonials",
        "enabled": true,
        "title": "Real Routine Results",
        "items": [
          {
            "title": "Soft, clean flow",
            "text": "The routine-first layout makes products easier to understand.",
            "author": "Nisha P."
          },
          {
            "title": "Premium feel",
            "text": "Great for skincare and beauty bundles.",
            "author": "Elena S."
          },
          {
            "title": "Simple discovery",
            "text": "Categories and best sellers are easy to browse.",
            "author": "Priya M."
          }
        ]
      },
      {
        "id": "promo",
        "type": "promo-banners",
        "enabled": true,
        "title": "Self-Care Offers",
        "variant": "asymmetric"
      },
      {
        "id": "newsletter",
        "type": "newsletter-signup",
        "enabled": true,
        "title": "Beauty Notes",
        "subtitle": "Share routines, launch alerts, and care guides.",
        "ctaText": "Get Updates"
      }
