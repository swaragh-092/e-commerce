{
  "schemaVersion": 3,
  "meta": {
    "slug": "premium-retail",
    "name": "Premium Retail",
    "version": "1.0.0",
    "author": "Platform Templates",
    "description": "Warm storefront with emerald actions and coral accents. Built for fashion, lifestyle, and general retail launches.",
    "category": "general",
    "tags": [
      "light",
      "warm",
      "retail",
      "emerald",
      "coral"
    ],
    "previewImage": "data:image/svg+xml;base64,",
    "bestFor": "General retail stores that need a polished launch-ready homepage with offers and discovery."
  },
  "design": {
    "theme": {
      "mode": "light",
      "primaryColor": "#0f766e",
      "secondaryColor": "#f97316",
      "backgroundColor": "#f7f3ec",
      "surfaceColor": "#fffaf2",
      "textColor": "#1f2933",
      "fontFamily": "Inter",
      "headingFont": "Inter",
      "headingWeight": "800",
      "bodyWeight": "400",
      "lineHeight": "1.5",
      "letterSpacing": "0px",
      "headingLetterSpacing": "0px",
      "borderRadius": "12px",
      "headerStyle": "gradient",
      "buttonStyle": "solid",
      "cardStyle": "elevated",
      "backgroundStyle": "softGradient"
    }
  },
  "layout": {
    "nav": {
      "sticky": true,
      "showCategoryBar": true
    },
    "footerStyle": {
      "bgColor": "#1f2933",
      "fgColor": "#f7f3ec"
    },
    "announcementStyle": {
      "bgColor": "#0f766e",
      "fgColor": "#ffffff",
      "dismissible": true
    },
    "homepageSections": [
      {
        "id": "hero",
        "type": "hero-carousel",
        "enabled": true,
        "autoPlay": true,
        "interval": 6500,
        "variant": "product-spotlight"
      },
      {
        "id": "value-props",
        "type": "trust-badges",
        "enabled": true,
        "items": [
          {
            "title": "Fast Delivery",
            "text": "Reliable shipping"
          },
          {
            "title": "Daily Offers",
            "text": "Fresh promotions"
          },
          {
            "title": "Secure Checkout",
            "text": "Protected payment flow"
          },
          {
            "title": "Easy Support",
            "text": "Help when needed"
          }
        ],
        "variant": "card-grid"
      },
      {
        "id": "categories",
        "type": "featured-collection-grid",
        "enabled": true,
        "title": "Shop Popular Categories",
        "count": 8,
        "dynamic": true
      },
      {
        "id": "featured",
        "type": "product-row",
        "enabled": true,
        "title": "Featured Products",
        "source": "featured",
        "dataSourceKey": "featured-products",
        "count": 8,
        "layout": "carousel",
        "viewAllLink": "/products?featured=true"
      },
      {
        "id": "promo",
        "type": "promo-banners",
        "enabled": true,
        "title": "Today In Store"
      },
      {
        "id": "new-arrivals",
        "type": "product-row",
        "enabled": true,
        "title": "New Arrivals",
        "source": "newest",
        "count": 8,
        "layout": "grid",
        "viewAllLink": "/products?sort=newest"
      },
      {
        "id": "newsletter",
        "type": "newsletter-signup",
        "enabled": true,
        "title": "Never Miss A Deal",
        "subtitle": "Launch offers, new arrivals, and retail updates.",
        "ctaText": "Get Updates",
        "variant": "banner"
      }
    ]
  },
  "demoContent": {
    "announcementText": "Fresh arrivals and curated picks are live.",
    "heroSlides": [
      {
        "eyebrow": "New Season",
        "title": "Fresh Arrivals for Every Style",
        "subtitle": "Discover curated collections for fashion, home, and lifestyle.",
        "buttonText": "Shop Now",
        "buttonLink": "/products",
        "secondaryButtonText": "View Deals",
        "secondaryButtonLink": "/products?onSale=true",
        "image": "https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1800&q=80",
        "position": "center",
        "color": "#ffffff"
      },
      {
        "eyebrow": "Weekend Picks",
        "title": "Essentials That Sell Fast",
        "subtitle": "A balanced storefront for everyday retail and seasonal campaigns.",
        "buttonText": "Explore Picks",
        "buttonLink": "/products?featured=true",
        "image": "https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=1800&q=80",
        "position": "center",
        "color": "#ffffff"
      }
    ],
    "valueProps": [
      {
        "icon": "shipping",
        "title": "Fast Delivery",
        "text": "Reliable shipping on every order"
      },
      {
        "icon": "offers",
        "title": "Daily Offers",
        "text": "Fresh deals across top categories"
      },
      {
        "icon": "secure",
        "title": "Secure Payments",
        "text": "Protected checkout experience"
      },
      {
        "icon": "support",
        "title": "Easy Support",
        "text": "Help when you need it"
      }
    ],
    "promoBanners": [
      {
        "kicker": "Limited Time",
        "title": "Flat 40% Off",
        "subtitle": "Season-ready looks and daily essentials.",
        "ctaText": "Grab Offers",
        "link": "/products?onSale=true",
        "color": "#fff7ed",
        "accentColor": "#f97316"
      },
      {
        "kicker": "Just In",
        "title": "New Everyday Favorites",
        "subtitle": "Fresh products selected for repeat shoppers.",
        "ctaText": "See New",
        "link": "/products?sort=newest",
        "color": "#ecfdf5",
        "accentColor": "#0f766e"
      }
    ]
  },
  "capabilities": {
    "design": true,
    "layoutStyle": true,
    "homepageSections": true,
    "demoContent": true,
    "pageTemplates": true,
    "dataSources": true,
    "customCode": false,
    "componentStyles": true,
    "sectionPresets": true
  },
  "dataSources": [
    {
      "key": "featured-products",
      "type": "apiBuilder",
      "definition": {
        "name": "Premium Retail Featured Products",
        "description": "Template-owned storefront endpoint for Premium Retail product rows.",
        "isActive": true,
        "config": {
          "responseMode": "object",
          "includeMeta": true,
          "blocks": [
            {
              "key": "products",
              "resource": "products",
              "enabled": true,
              "mode": "filtered",
              "limit": 8,
              "fields": [
                "id",
                "name",
                "slug",
                "shortDescription",
                "price",
                "salePrice",
                "saleLabel",
                "avgRating",
                "reviewCount",
                "brandId",
                "createdAt"
              ],
              "filters": [
                {
                  "field": "isFeatured",
                  "operator": "equals",
                  "source": "static",
                  "value": true
                }
              ],
              "relations": [
                {
                  "key": "images",
                  "relation": "images",
                  "resource": "productImages",
                  "enabled": true,
                  "mode": "all",
                  "limit": 1,
                  "fields": [
                    "url",
                    "alt",
                    "isPrimary",
                    "sortOrder"
                  ],
                  "sortBy": "sortOrder",
                  "sortOrder": "ASC"
                }
              ],
              "sortBy": "createdAt",
              "sortOrder": "DESC"
            }
          ]
        }
      }
    }
  ],
  "pageTemplates": {
    "product": {
      "layout": "sticky-purchase-panel",
      "showTrustBadges": true,
      "showRelatedProducts": true,
      "showRecentlyViewed": true,
      "showStickyAddToCart": true,
      "showBreadcrumbs": true
    },
    "collection": {
      "layout": "sidebar-filters-grid",
      "productsPerRow": 4,
      "filterLayout": "sidebar",
      "showBreadcrumbs": true
    }
  },
  "componentStyles": {
    "productCard": {
      "variant": "classic",
      "imageRatio": "4/3",
      "imageFit": "cover",
      "showBrand": true,
      "showCategory": true,
      "showRating": true,
      "showWishlist": true,
      "showSaleCountdown": true,
      "priceStyle": "bold",
      "badgeStyle": "pill",
      "badgePosition": "top-right",
      "hoverEffect": "lift",
      "radius": "medium",
      "shadow": "soft",
      "density": "comfortable"
    },
    "categoryCard": {
      "variant": "image-tile",
      "imageRatio": "1/1",
      "imageFit": "cover",
      "titlePlacement": "below",
      "showSubtitle": false,
      "showProductCount": false,
      "hoverEffect": "zoom",
      "radius": "medium",
      "shadow": "soft",
      "density": "comfortable"
    },
    "promoCard": {
      "variant": "split-image",
      "imagePlacement": "right",
      "titleSize": "large",
      "ctaStyle": "button",
      "radius": "large",
      "shadow": "soft"
    },
    "brandCard": {
      "variant": "logo-card",
      "hoverEffect": "lift",
      "radius": "medium",
      "shadow": "none"
    },
    "trustCard": {
      "variant": "icon-row",
      "titleSize": "medium",
      "radius": "medium",
      "shadow": "none"
    }
  },
  "sectionPresets": {
    "hero": {
      "type": "hero-carousel",
      "autoPlay": true,
      "interval": 6500,
      "variant": "product-spotlight"
    },
    "trust": {
      "type": "trust-badges",
      "items": [
        {
          "title": "Fast Delivery",
          "text": "Reliable shipping"
        },
        {
          "title": "Daily Offers",
          "text": "Fresh promotions"
        },
        {
          "title": "Secure Checkout",
          "text": "Protected payment flow"
        },
        {
          "title": "Easy Support",
          "text": "Help when needed"
        }
      ],
      "variant": "card-grid"
    },
    "categoryGrid": {
      "type": "featured-collection-grid",
      "title": "Shop Popular Categories",
      "count": 8,
      "dynamic": true
    },
    "productRow": {
      "type": "product-row",
      "title": "Featured Products",
      "source": "featured",
      "count": 8,
      "layout": "carousel",
      "viewAllLink": "/products?featured=true"
    },
    "promoBanner": {
      "type": "promo-banners",
      "title": "Today In Store"
    },
    "newsletter": {
      "type": "newsletter-signup",
      "title": "Never Miss A Deal",
      "subtitle": "Launch offers, new arrivals, and retail updates.",
      "ctaText": "Get Updates",
      "variant": "banner"
    }
  }
}
