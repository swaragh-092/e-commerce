{
  "schemaVersion": 3,
  "meta": {
    "slug": "bookstore-classic",
    "name": "Bookstore Classic",
    "version": "1.0.0",
    "author": "Platform Templates",
    "description": "Readable serif template for bookstores, authors, stationery, education products, and curated collections.",
    "category": "books",
    "tags": [
      "books",
      "serif",
      "classic",
      "sepia",
      "reading"
    ],
    "previewImage": "data:image/svg+xml;base64,",
    "bestFor": "Bookstores, publishers, stationery shops, authors, and education catalogs."
  },
  "design": {
    "theme": {
      "mode": "light",
      "primaryColor": "#7c2d12",
      "secondaryColor": "#2563eb",
      "backgroundColor": "#f8f1e5",
      "surfaceColor": "#fffaf0",
      "textColor": "#2f261f",
      "fontFamily": "Merriweather",
      "headingFont": "Merriweather",
      "headingWeight": "700",
      "bodyWeight": "400",
      "lineHeight": "1.7",
      "letterSpacing": "0px",
      "headingLetterSpacing": "0px",
      "borderRadius": "8px",
      "headerStyle": "solid",
      "buttonStyle": "outline",
      "cardStyle": "outlined",
      "backgroundStyle": "softGradient"
    }
  },
  "layout": {
    "nav": {
      "sticky": true,
      "showCategoryBar": true
    },
    "footerStyle": {
      "bgColor": "#2f261f",
      "fgColor": "#f8f1e5"
    },
    "announcementStyle": {
      "bgColor": "#7c2d12",
      "fgColor": "#ffffff",
      "dismissible": true
    },
    "homepageSections": [
      {
        "id": "hero",
        "type": "hero-carousel",
        "enabled": true,
        "autoPlay": true,
        "interval": 7000,
        "variant": "split"
      },
      {
        "id": "editorial-pick",
        "type": "editorial-image-text",
        "enabled": true,
        "title": "Staff Picks With A Point Of View",
        "subtitle": "Bookstores need curation. Use story-led sections for genres, authors, and seasonal reading.",
        "image": "https://images.unsplash.com/photo-1512820790803-83ca734da794?auto=format&fit=crop&w=1200&q=80",
        "imagePosition": "right",
        "ctaText": "Browse Books",
        "ctaLink": "/products"
      },
      {
        "id": "categories",
        "type": "featured-collection-grid",
        "enabled": true,
        "title": "Browse The Shelves",
        "count": 8,
        "dynamic": true
      },
      {
        "id": "featured",
        "type": "product-row",
        "enabled": true,
        "title": "New On The Shelf",
        "source": "featured",
        "dataSourceKey": "featured-products",
        "count": 8,
        "layout": "carousel",
        "viewAllLink": "/products?featured=true"
      },
      {
        "id": "testimonials",
        "type": "testimonials",
        "enabled": true,
        "title": "Reader Notes",
        "items": [
          {
            "title": "Feels curated",
            "text": "Great for staff picks and author highlights.",
            "author": "Anika D."
          },
          {
            "title": "Easy discovery",
            "text": "The shelf-style structure makes browsing natural.",
            "author": "Jon P."
          }
        ]
      },
      {
        "id": "newsletter",
        "type": "newsletter-signup",
        "enabled": true,
        "title": "Reading List Dispatch",
        "subtitle": "Send new releases, events, and recommendations.",
        "ctaText": "Join Readers",
        "variant": "inline-form"
      }
    ]
  },
  "demoContent": {
    "announcementText": "New releases and reader favorites are ready for your shelf.",
    "heroSlides": [
      {
        "eyebrow": "Staff Picks",
        "title": "Stories Worth Making Space For",
        "subtitle": "A classic storefront for readers, authors, and curated bookshelves.",
        "buttonText": "Browse Books",
        "buttonLink": "/products",
        "secondaryButtonText": "New Releases",
        "secondaryButtonLink": "/products?sort=newest",
        "image": "https://images.unsplash.com/photo-1512820790803-83ca734da794?auto=format&fit=crop&w=1800&q=80",
        "position": "center",
        "color": "#ffffff"
      },
      {
        "eyebrow": "New Releases",
        "title": "Build A Better Reading List",
        "subtitle": "Serif typography and curated rows for book discovery.",
        "buttonText": "Shop New Releases",
        "buttonLink": "/products?sort=newest",
        "image": "https://images.unsplash.com/photo-1521587760476-6c12a4b040da?auto=format&fit=crop&w=1800&q=80",
        "position": "center",
        "color": "#ffffff"
      }
    ],
    "valueProps": [
      {
        "icon": "verified",
        "title": "Curated Shelves",
        "text": "Thoughtful recommendations"
      },
      {
        "icon": "shipping",
        "title": "Book Safe Shipping",
        "text": "Packed carefully"
      },
      {
        "icon": "offers",
        "title": "Reader Offers",
        "text": "Deals on collections"
      },
      {
        "icon": "support",
        "title": "Helpful Picks",
        "text": "Guidance for readers"
      }
    ],
    "promoBanners": [
      {
        "kicker": "Reader Deal",
        "title": "Build Your Stack",
        "subtitle": "Save on selected books and collections.",
        "ctaText": "Shop Offers",
        "link": "/products?onSale=true",
        "color": "#fffbeb",
        "accentColor": "#7c2d12"
      },
      {
        "kicker": "Curated",
        "title": "Author Picks",
        "subtitle": "Books and stationery chosen for thoughtful gifting.",
        "ctaText": "Browse Picks",
        "link": "/products?featured=true",
        "color": "#eff6ff",
        "accentColor": "#2563eb"
      }
    ]
  },
  "capabilities": {
    "design": true,
    "layoutStyle": true,
    "homepageSections": true,
    "demoContent": true,
    "pageTemplates": true,
    "dataSources": true,
    "customCode": false,
    "componentStyles": true,
    "sectionPresets": true
  },
  "dataSources": [
    {
      "key": "featured-products",
      "type": "apiBuilder",
      "definition": {
        "name": "Bookstore Classic Featured Products",
        "description": "Template-owned storefront endpoint for Bookstore Classic product rows.",
        "isActive": true,
        "config": {
          "responseMode": "object",
          "includeMeta": true,
          "blocks": [
            {
              "key": "products",
              "resource": "products",
              "enabled": true,
              "mode": "filtered",
              "limit": 8,
              "fields": [
                "id",
                "name",
                "slug",
                "shortDescription",
                "price",
                "salePrice",
                "saleLabel",
                "avgRating",
                "reviewCount",
                "brandId",
                "createdAt"
              ],
              "filters": [
                {
                  "field": "isFeatured",
                  "operator": "equals",
                  "source": "static",
                  "value": true
                }
              ],
              "relations": [
                {
                  "key": "images",
                  "relation": "images",
                  "resource": "productImages",
                  "enabled": true,
                  "mode": "all",
                  "limit": 1,
                  "fields": [
                    "url",
                    "alt",
                    "isPrimary",
                    "sortOrder"
                  ],
                  "sortBy": "sortOrder",
                  "sortOrder": "ASC"
                }
              ],
              "sortBy": "createdAt",
              "sortOrder": "DESC"
            }
          ]
        }
      }
    }
  ],
  "pageTemplates": {
    "product": {
      "layout": "luxury-editorial",
      "showTrustBadges": true,
      "showRelatedProducts": true,
      "showRecentlyViewed": true,
      "showStickyAddToCart": false,
      "showBreadcrumbs": true
    },
    "collection": {
      "layout": "editorial-collection-grid",
      "productsPerRow": 3,
      "filterLayout": "sidebar",
      "showBreadcrumbs": true
    }
  },
  "componentStyles": {
    "productCard": {
      "variant": "minimal",
      "imageRatio": "3/4",
      "imageFit": "cover",
      "showBrand": false,
      "showCategory": true,
      "showRating": true,
      "showWishlist": true,
      "showSaleCountdown": false,
      "priceStyle": "regular",
      "badgeStyle": "minimal",
      "badgePosition": "top-right",
      "hoverEffect": "lift",
      "radius": "small",
      "shadow": "soft",
      "density": "comfortable"
    },
    "categoryCard": {
      "variant": "image-tile",
      "imageRatio": "4/3",
      "imageFit": "cover",
      "titlePlacement": "below",
      "showSubtitle": true,
      "showProductCount": true,
      "hoverEffect": "lift",
      "radius": "small",
      "shadow": "none",
      "density": "comfortable"
    },
    "promoCard": {
      "variant": "banner-stack",
      "imagePlacement": "left",
      "titleSize": "medium",
      "ctaStyle": "text-link",
      "radius": "small",
      "shadow": "soft"
    },
    "brandCard": {
      "variant": "logo-only",
      "hoverEffect": "lift",
      "radius": "small",
      "shadow": "none"
    },
    "trustCard": {
      "variant": "icon-row",
      "titleSize": "small",
      "radius": "small",
      "shadow": "none"
    }
  },
  "sectionPresets": {
    "hero": {
      "type": "hero-carousel",
      "autoPlay": true,
      "interval": 7000,
      "variant": "split"
    },
    "editorial": {
      "type": "editorial-image-text",
      "title": "Staff Picks With A Point Of View",
      "subtitle": "Bookstores need curation. Use story-led sections for genres, authors, and seasonal reading.",
      "image": "https://images.unsplash.com/photo-1512820790803-83ca734da794?auto=format&fit=crop&w=1200&q=80",
      "imagePosition": "right",
      "ctaText": "Browse Books",
      "ctaLink": "/products"
    },
    "categoryGrid": {
      "type": "featured-collection-grid",
      "title": "Browse The Shelves",
      "count": 8,
      "dynamic": true
    },
    "productRow": {
      "type": "product-row",
      "title": "New On The Shelf",
      "source": "featured",
      "count": 8,
      "layout": "carousel",
      "viewAllLink": "/products?featured=true"
    },
    "socialProof": {
      "type": "testimonials",
      "title": "Reader Notes",
      "items": [
        {
          "title": "Feels curated",
          "text": "Great for staff picks and author highlights.",
          "author": "Anika D."
        },
        {
          "title": "Easy discovery",
          "text": "The shelf-style structure makes browsing natural.",
          "author": "Jon P."
        }
      ]
    },
    "newsletter": {
      "type": "newsletter-signup",
      "title": "Reading List Dispatch",
      "subtitle": "Send new releases, events, and recommendations.",
      "ctaText": "Join Readers",
      "variant": "inline-form"
    }
  }
}
