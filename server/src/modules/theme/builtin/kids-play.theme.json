{
  "schemaVersion": 3,
  "meta": {
    "slug": "kids-play",
    "name": "Kids Play",
    "version": "1.0.0",
    "author": "Platform Templates",
    "description": "Colorful rounded template for toys, kids products, games, school items, and playful catalogs.",
    "category": "kids",
    "tags": [
      "kids",
      "toys",
      "colorful",
      "rounded",
      "playful"
    ],
    "previewImage": "data:image/svg+xml;base64,",
    "bestFor": "Kids, toys, baby products, learning kits, and playful family storefronts."
  },
  "design": {
    "theme": {
      "mode": "light",
      "primaryColor": "#7c3aed",
      "secondaryColor": "#f97316",
      "backgroundColor": "#fefce8",
      "surfaceColor": "#ffffff",
      "textColor": "#1f2937",
      "fontFamily": "Nunito",
      "headingFont": "Nunito",
      "headingWeight": "800",
      "bodyWeight": "400",
      "lineHeight": "1.55",
      "letterSpacing": "0px",
      "headingLetterSpacing": "0px",
      "borderRadius": "22px",
      "headerStyle": "gradient",
      "buttonStyle": "soft",
      "cardStyle": "elevated",
      "backgroundStyle": "softGradient"
    }
  },
  "layout": {
    "nav": {
      "sticky": true,
      "showCategoryBar": true
    },
    "footerStyle": {
      "bgColor": "#4c1d95",
      "fgColor": "#fefce8"
    },
    "announcementStyle": {
      "bgColor": "#f97316",
      "fgColor": "#ffffff",
      "dismissible": true
    },
    "homepageSections": [
      {
        "id": "hero",
        "type": "hero-carousel",
        "enabled": true,
        "autoPlay": true,
        "interval": 6000,
        "variant": "overlay"
      },
      {
        "id": "value-props",
        "type": "trust-badges",
        "enabled": true,
        "items": [
          {
            "title": "Safe Choices",
            "text": "Make trust visible"
          },
          {
            "title": "Age Friendly",
            "text": "Guide by age and play style"
          },
          {
            "title": "Gift Ready",
            "text": "Support birthdays and holidays"
          },
          {
            "title": "Fast Delivery",
            "text": "For last-minute gifts"
          }
        ]
      },
      {
        "id": "categories",
        "type": "featured-collection-grid",
        "enabled": true,
        "title": "Shop By Playtime",
        "count": 8,
        "dynamic": true
      },
      {
        "id": "featured",
        "type": "product-row",
        "enabled": true,
        "title": "Playroom Favorites",
        "source": "featured",
        "dataSourceKey": "featured-products",
        "count": 8,
        "layout": "grid",
        "viewAllLink": "/products?featured=true"
      },
      {
        "id": "play-story",
        "type": "editorial-image-text",
        "enabled": true,
        "title": "Learning Through Play",
        "subtitle": "Use storytelling blocks to explain benefits for parents and gift buyers.",
        "image": "https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?auto=format&fit=crop&w=1200&q=80",
        "imagePosition": "left",
        "ctaText": "Shop Toys",
        "ctaLink": "/products"
      },
      {
        "id": "promo",
        "type": "countdown-sale",
        "enabled": true,
        "title": "Weekend Toy Deals",
        "subtitle": "Limited-time picks for birthdays and playrooms.",
        "ctaText": "Shop Deals",
        "ctaLink": "/products?onSale=true"
      },
      {
        "id": "testimonials",
        "type": "testimonials",
        "enabled": true,
        "title": "Parent Approved",
        "items": [
          {
            "title": "Easy gift choice",
            "text": "The layout helps parents pick quickly.",
            "author": "Riya S."
          },
          {
            "title": "Fun and clear",
            "text": "Categories make browsing simple.",
            "author": "Meera J."
          }
        ]
      }
    ]
  },
  "demoContent": {
    "announcementText": "Playtime picks are here. Save on toys, games, and gifts.",
    "heroSlides": [
      {
        "eyebrow": "Play More",
        "title": "Bright Finds For Curious Kids",
        "subtitle": "Toys, games, gifts, and learning essentials in one happy store.",
        "buttonText": "Shop Toys",
        "buttonLink": "/products",
        "secondaryButtonText": "Gift Ideas",
        "secondaryButtonLink": "/products?featured=true",
        "image": "https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?auto=format&fit=crop&w=1800&q=80",
        "position": "center",
        "color": "#ffffff"
      },
      {
        "eyebrow": "Gift Season",
        "title": "Fun For Every Age And Stage",
        "subtitle": "A playful template with rounded cards and colorful discovery.",
        "buttonText": "Browse Gifts",
        "buttonLink": "/products?featured=true",
        "image": "https://images.unsplash.com/photo-1515488042361-ee00e0ddd4e4?auto=format&fit=crop&w=1800&q=80",
        "position": "center",
        "color": "#ffffff"
      }
    ],
    "valueProps": [
      {
        "icon": "verified",
        "title": "Kid Friendly",
        "text": "Selected with care"
      },
      {
        "icon": "shipping",
        "title": "Gift Ready",
        "text": "Fast delivery options"
      },
      {
        "icon": "offers",
        "title": "Play Deals",
        "text": "Offers for families"
      },
      {
        "icon": "support",
        "title": "Easy Returns",
        "text": "Simple help for parents"
      }
    ],
    "promoBanners": [
      {
        "kicker": "Gift Picks",
        "title": "Toys Kids Actually Want",
        "subtitle": "Colorful categories and playful merchandising.",
        "ctaText": "Shop Gifts",
        "link": "/products?featured=true",
        "color": "#ede9fe",
        "accentColor": "#7c3aed"
      },
      {
        "kicker": "Save",
        "title": "Playroom Refresh",
        "subtitle": "Deals on games, learning toys, and activities.",
        "ctaText": "See Offers",
        "link": "/products?onSale=true",
        "color": "#ffedd5",
        "accentColor": "#f97316"
      }
    ]
  },
  "capabilities": {
    "design": true,
    "layoutStyle": true,
    "homepageSections": true,
    "demoContent": true,
    "pageTemplates": true,
    "dataSources": true,
    "customCode": false,
    "componentStyles": true,
    "sectionPresets": true
  },
  "dataSources": [
    {
      "key": "featured-products",
      "type": "apiBuilder",
      "definition": {
        "name": "Kids Play Featured Products",
        "description": "Template-owned storefront endpoint for Kids Play product rows.",
        "isActive": true,
        "config": {
          "responseMode": "object",
          "includeMeta": true,
          "blocks": [
            {
              "key": "products",
              "resource": "products",
              "enabled": true,
              "mode": "filtered",
              "limit": 8,
              "fields": [
                "id",
                "name",
                "slug",
                "shortDescription",
                "price",
                "salePrice",
                "saleLabel",
                "avgRating",
                "reviewCount",
                "brandId",
                "createdAt"
              ],
              "filters": [
                {
                  "field": "isFeatured",
                  "operator": "equals",
                  "source": "static",
                  "value": true
                }
              ],
              "relations": [
                {
                  "key": "images",
                  "relation": "images",
                  "resource": "productImages",
                  "enabled": true,
                  "mode": "all",
                  "limit": 1,
                  "fields": [
                    "url",
                    "alt",
                    "isPrimary",
                    "sortOrder"
                  ],
                  "sortBy": "sortOrder",
                  "sortOrder": "ASC"
                }
              ],
              "sortBy": "createdAt",
              "sortOrder": "DESC"
            }
          ]
        }
      }
    }
  ],
  "pageTemplates": {
    "product": {
      "layout": "media-left-details-right",
      "showTrustBadges": true,
      "showRelatedProducts": true,
      "showRecentlyViewed": false,
      "showStickyAddToCart": true,
      "showBreadcrumbs": true
    },
    "collection": {
      "layout": "image-led-category-browsing",
      "productsPerRow": 3,
      "filterLayout": "topbar",
      "showBreadcrumbs": true
    }
  },
  "componentStyles": {
    "productCard": {
      "variant": "classic",
      "imageRatio": "1/1",
      "imageFit": "cover",
      "showBrand": false,
      "showCategory": true,
      "showRating": true,
      "showWishlist": true,
      "showSaleCountdown": true,
      "priceStyle": "bold",
      "badgeStyle": "pill",
      "badgePosition": "top-right",
      "hoverEffect": "zoom",
      "radius": "large",
      "shadow": "medium",
      "density": "spacious"
    },
    "categoryCard": {
      "variant": "image-tile",
      "imageRatio": "1/1",
      "imageFit": "cover",
      "titlePlacement": "centered",
      "showSubtitle": false,
      "showProductCount": false,
      "hoverEffect": "zoom",
      "radius": "pill",
      "shadow": "soft",
      "density": "spacious"
    },
    "promoCard": {
      "variant": "cards",
      "imagePlacement": "top",
      "titleSize": "large",
      "ctaStyle": "button",
      "radius": "large",
      "shadow": "medium"
    },
    "brandCard": {
      "variant": "logo-card",
      "hoverEffect": "lift",
      "radius": "pill",
      "shadow": "soft"
    },
    "trustCard": {
      "variant": "card-grid",
      "titleSize": "medium",
      "radius": "large",
      "shadow": "soft"
    }
  },
