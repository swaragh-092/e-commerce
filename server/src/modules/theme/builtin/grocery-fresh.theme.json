{
  "schemaVersion": 3,
  "meta": {
    "slug": "grocery-fresh",
    "name": "Grocery Fresh",
    "version": "1.0.0",
    "author": "Platform Templates",
    "description": "Fresh grocery template with fast category discovery, weekly deals, and delivery-focused value props.",
    "category": "grocery",
    "tags": [
      "grocery",
      "fresh",
      "food",
      "delivery",
      "green"
    ],
    "previewImage": "data:image/svg+xml;base64,",
    "bestFor": "Grocery, organic food, farm boxes, local delivery, and fresh produce shops."
  },
  "design": {
    "theme": {
      "mode": "light",
      "primaryColor": "#15803d",
      "secondaryColor": "#f59e0b",
      "backgroundColor": "#f7fee7",
      "surfaceColor": "#ffffff",
      "textColor": "#1f2937",
      "fontFamily": "Inter",
      "headingFont": "Inter",
      "headingWeight": "800",
      "bodyWeight": "400",
      "lineHeight": "1.5",
      "letterSpacing": "0px",
      "headingLetterSpacing": "0px",
      "borderRadius": "16px",
      "headerStyle": "solid",
      "buttonStyle": "solid",
      "cardStyle": "outlined",
      "backgroundStyle": "softGradient"
    }
  },
  "layout": {
    "nav": {
      "sticky": true,
      "showCategoryBar": true
    },
    "footerStyle": {
      "bgColor": "#14532d",
      "fgColor": "#f7fee7"
    },
    "announcementStyle": {
      "bgColor": "#15803d",
      "fgColor": "#ffffff",
      "dismissible": true
    },
    "homepageSections": [
      {
        "id": "hero",
        "type": "hero-carousel",
        "enabled": true,
        "autoPlay": true,
        "interval": 6500,
        "variant": "split"
      },
      {
        "id": "value-props",
        "type": "trust-badges",
        "enabled": true,
        "items": [
          {
            "title": "Fresh Daily",
            "text": "Local produce and pantry essentials"
          },
          {
            "title": "Scheduled Delivery",
            "text": "Make delivery promises visible"
          },
          {
            "title": "Weekly Deals",
            "text": "Drive basket size with offers"
          },
          {
            "title": "Easy Reorder",
            "text": "Support repeat grocery habits"
          }
        ]
      },
      {
        "id": "categories",
        "type": "featured-collection-grid",
        "enabled": true,
        "title": "Shop Fresh Departments",
        "subtitle": "Produce, pantry, bakery, dairy, and more.",
        "count": 8,
        "dynamic": true,
        "variant": "compact-chips"
      },
      {
        "id": "featured",
        "type": "product-row",
        "enabled": true,
        "title": "Fresh Picks Today",
        "source": "featured",
        "dataSourceKey": "featured-products",
        "count": 8,
        "layout": "grid",
        "viewAllLink": "/products?featured=true",
        "variant": "grid"
      },
      {
        "id": "farm-story",
        "type": "editorial-image-text",
        "enabled": true,
        "title": "From Fresh Shelf To Front Door",
        "subtitle": "Tell the delivery, freshness, or sourcing story before shoppers fill the cart.",
        "image": "https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=1200&q=80",
        "imagePosition": "right",
        "ctaText": "Shop Groceries",
        "ctaLink": "/products"
      },
      {
        "id": "promo",
        "type": "promo-banners",
        "enabled": true,
        "title": "This Week In Store",
        "variant": "banner-stack"
      },
      {
        "id": "newsletter",
        "type": "newsletter-signup",
        "enabled": true,
        "title": "Get Weekly Fresh Deals",
        "subtitle": "Send produce drops and pantry offers straight to shoppers.",
        "ctaText": "Subscribe",
        "variant": "banner"
      }
    ]
  },
  "demoContent": {
    "announcementText": "Fresh delivery slots available today. Save on weekly essentials.",
    "heroSlides": [
      {
        "eyebrow": "Fresh Today",
        "title": "Groceries For The Week In One Tap",
        "subtitle": "Produce, pantry, snacks, and daily essentials delivered fast.",
        "buttonText": "Start Shopping",
        "buttonLink": "/products",
        "secondaryButtonText": "View Deals",
        "secondaryButtonLink": "/products?onSale=true",
        "image": "https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=1800&q=80",
        "position": "center",
        "color": "#ffffff"
      },
      {
        "eyebrow": "Local Picks",
        "title": "Fresh Produce And Pantry Staples",
        "subtitle": "A template built around categories, offers, and repeat buying.",
        "buttonText": "Shop Fresh",
        "buttonLink": "/products?featured=true",
        "image": "https://images.unsplash.com/photo-1488459716781-31db52582fe9?auto=format&fit=crop&w=1800&q=80",
        "position": "center",
        "color": "#ffffff"
      }
    ],
    "valueProps": [
      {
        "icon": "shipping",
        "title": "Fast Delivery",
        "text": "Same-day slots available"
      },
      {
        "icon": "verified",
        "title": "Fresh Quality",
        "text": "Picked with care"
      },
      {
        "icon": "offers",
        "title": "Weekly Deals",
        "text": "Save on essentials"
      },
      {
        "icon": "support",
        "title": "Easy Help",
        "text": "Order support ready"
      }
    ],
    "promoBanners": [
      {
        "kicker": "Weekly Deal",
        "title": "Fresh Basket Savings",
        "subtitle": "Produce, dairy, snacks, and pantry staples.",
        "ctaText": "Shop Deals",
        "link": "/products?onSale=true",
        "color": "#dcfce7",
        "accentColor": "#15803d"
      },
      {
        "kicker": "Delivery",
        "title": "Tonight Dinner Sorted",
        "subtitle": "Everything for quick meals and family favorites.",
        "ctaText": "Shop Meals",
        "link": "/products?featured=true",
        "color": "#fef3c7",
        "accentColor": "#f59e0b"
      }
    ]
  },
  "capabilities": {
    "design": true,
    "layoutStyle": true,
    "homepageSections": true,
    "demoContent": true,
    "pageTemplates": true,
    "dataSources": true,
    "customCode": false,
    "componentStyles": true,
    "sectionPresets": true
  },
  "dataSources": [
    {
      "key": "featured-products",
      "type": "apiBuilder",
      "definition": {
        "name": "Grocery Fresh Featured Products",
        "description": "Template-owned storefront endpoint for Grocery Fresh product rows.",
        "isActive": true,
        "config": {
          "responseMode": "object",
          "includeMeta": true,
          "blocks": [
            {
              "key": "products",
              "resource": "products",
              "enabled": true,
              "mode": "filtered",
              "limit": 8,
              "fields": [
                "id",
                "name",
                "slug",
                "shortDescription",
                "price",
                "salePrice",
                "saleLabel",
                "avgRating",
                "reviewCount",
                "brandId",
                "createdAt"
              ],
              "filters": [
                {
                  "field": "isFeatured",
                  "operator": "equals",
                  "source": "static",
                  "value": true
                }
              ],
              "relations": [
                {
                  "key": "images",
                  "relation": "images",
                  "resource": "productImages",
                  "enabled": true,
                  "mode": "all",
                  "limit": 1,
                  "fields": [
                    "url",
                    "alt",
                    "isPrimary",
                    "sortOrder"
                  ],
                  "sortBy": "sortOrder",
                  "sortOrder": "ASC"
                }
              ],
              "sortBy": "createdAt",
              "sortOrder": "DESC"
            }
          ]
        }
      }
    }
  ],
  "pageTemplates": {
    "product": {
      "layout": "sticky-purchase-panel",
      "showTrustBadges": true,
      "showRelatedProducts": true,
      "showRecentlyViewed": false,
      "showStickyAddToCart": true,
      "showBreadcrumbs": true
    },
    "collection": {
      "layout": "image-led-category-browsing",
      "productsPerRow": 4,
      "filterLayout": "topbar",
      "showBreadcrumbs": true
    }
  },
  "componentStyles": {
    "productCard": {
      "variant": "deal",
      "imageRatio": "1/1",
      "imageFit": "cover",
      "showBrand": false,
      "showCategory": true,
      "showRating": true,
      "showWishlist": false,
      "showSaleCountdown": true,
      "priceStyle": "bold",
      "badgeStyle": "pill",
      "badgePosition": "top-left",
      "hoverEffect": "lift",
      "radius": "large",
      "shadow": "soft",
      "density": "compact"
    },
    "categoryCard": {
      "variant": "icon-grid",
      "imageRatio": "1/1",
      "imageFit": "cover",
      "titlePlacement": "below",
      "showSubtitle": false,
      "showProductCount": false,
      "hoverEffect": "zoom",
      "radius": "pill",
      "shadow": "none",
      "density": "comfortable"
    },
    "promoCard": {
      "variant": "split-image",
      "imagePlacement": "right",
      "titleSize": "medium",
      "ctaStyle": "button",
      "radius": "large",
      "shadow": "soft"
    },
    "brandCard": {
      "variant": "logo-card",
      "hoverEffect": "lift",
      "radius": "pill",
      "shadow": "none"
    },
    "trustCard": {
      "variant": "icon-row",
      "titleSize": "small",
      "radius": "pill",
      "shadow": "none"
    }
  },
  "sectionPresets": {
    "hero": {
      "type": "hero-carousel",
      "autoPlay": true,
      "interval": 6500,
      "variant": "split"
    },
    "trust": {
      "type": "trust-badges",
      "items": [
        {
          "title": "Fresh Daily",
          "text": "Local produce and pantry essentials"
        },
        {
          "title": "Scheduled Delivery",
          "text": "Make delivery promises visible"
        },
        {
          "title": "Weekly Deals",
          "text": "Drive basket size with offers"
        },
        {
          "title": "Easy Reorder",
          "text": "Support repeat grocery habits"
        }
      ]
    },
    "categoryGrid": {
      "type": "featured-collection-grid",
      "title": "Shop Fresh Departments",
      "subtitle": "Produce, pantry, bakery, dairy, and more.",
      "count": 8,
      "dynamic": true,
      "variant": "compact-chips"
    },
    "productRow": {
      "type": "product-row",
      "title": "Fresh Picks Today",
      "source": "featured",
      "count": 8,
      "layout": "grid",
      "viewAllLink": "/products?featured=true",
      "variant": "grid"
    },
    "editorial": {
      "type": "editorial-image-text",
      "title": "From Fresh Shelf To Front Door",
      "subtitle": "Tell the delivery, freshness, or sourcing story before shoppers fill the cart.",
      "image": "https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=1200&q=80",
      "imagePosition": "right",
      "ctaText": "Shop Groceries",
      "ctaLink": "/products"
    },
    "promoBanner": {
      "type": "promo-banners",
      "title": "This Week In Store",
      "variant": "banner-stack"
    },
    "newsletter": {
      "type": "newsletter-signup",
      "title": "Get Weekly Fresh Deals",
      "subtitle": "Send produce drops and pantry offers straight to shoppers.",
      "ctaText": "Subscribe",
      "variant": "banner"
    }
  }
}
