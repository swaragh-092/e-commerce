{
  "schemaVersion": 3,
  "meta": {
    "slug": "tech-pro",
    "name": "Tech Pro",
    "version": "1.0.0",
    "author": "Platform Templates",
    "description": "Dark electronics template with sharp contrast, blue/cyan accents, specs-led rows, and deal sections.",
    "category": "electronics",
    "tags": [
      "electronics",
      "tech",
      "dark",
      "blue",
      "gadgets"
    ],
    "previewImage": "data:image/svg+xml;base64,",
    "bestFor": "Electronics, gadgets, accessories, and high-spec catalog storefronts."
  },
  "design": {
    "theme": {
      "mode": "dark",
      "primaryColor": "#2563eb",
      "secondaryColor": "#06b6d4",
      "backgroundColor": "#020617",
      "surfaceColor": "#0f172a",
      "textColor": "#f8fafc",
      "fontFamily": "Inter",
      "headingFont": "Inter",
      "headingWeight": "800",
      "bodyWeight": "400",
      "lineHeight": "1.5",
      "letterSpacing": "0px",
      "headingLetterSpacing": "-0.02em",
      "borderRadius": "10px",
      "headerStyle": "solid",
      "buttonStyle": "solid",
      "cardStyle": "elevated",
      "backgroundStyle": "solid"
    }
  },
  "layout": {
    "nav": {
      "sticky": true,
      "showCategoryBar": true
    },
    "footerStyle": {
      "bgColor": "#020617",
      "fgColor": "#e2e8f0"
    },
    "announcementStyle": {
      "bgColor": "#2563eb",
      "fgColor": "#ffffff",
      "dismissible": true
    },
    "homepageSections": [
      {
        "id": "hero",
        "type": "hero-carousel",
        "enabled": true,
        "autoPlay": true,
        "interval": 6000,
        "variant": "product-spotlight"
      },
      {
        "id": "trust-badges",
        "type": "trust-badges",
        "enabled": true,
        "items": [
          {
            "title": "Warranty Ready",
            "text": "Show confidence before checkout"
          },
          {
            "title": "Fast Dispatch",
            "text": "Built for quick fulfillment"
          },
          {
            "title": "Secure Checkout",
            "text": "Protected purchase flow"
          },
          {
            "title": "Expert Picks",
            "text": "Guide shoppers to the right gear"
          }
        ],
        "variant": "card-grid"
      },
      {
        "id": "featured",
        "type": "product-row",
        "enabled": true,
        "title": "Featured Tech",
        "source": "featured",
        "dataSourceKey": "featured-products",
        "count": 8,
        "layout": "carousel",
        "viewAllLink": "/products?featured=true",
        "variant": "grid"
      },
      {
        "id": "spec-story",
        "type": "editorial-image-text",
        "enabled": true,
        "title": "Performance First Shopping",
        "subtitle": "Use editorial space to explain speed, battery, compatibility, or ecosystem benefits.",
        "image": "https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1200&q=80",
        "imagePosition": "left",
        "ctaText": "Explore Gear",
        "ctaLink": "/products"
      },
      {
        "id": "categories",
        "type": "featured-collection-grid",
        "enabled": true,
        "title": "Shop By Setup",
        "count": 6,
        "dynamic": true,
        "variant": "icon-grid"
      },
      {
        "id": "promo",
        "type": "countdown-sale",
        "enabled": true,
        "title": "Flash Tech Deals",
        "subtitle": "Limited-time offers on selected gear.",
        "ctaText": "View Deals",
        "ctaLink": "/products?onSale=true"
      },
      {
        "id": "brands",
        "type": "brand-showcase",
        "enabled": true,
        "title": "Top Tech Brands",
        "count": 10
      },
      {
        "id": "faq",
        "type": "faq",
        "enabled": true,
        "title": "Buying Questions",
        "items": [
          {
            "title": "Can shoppers compare specs?",
            "text": "Use product attributes and API Builder data sources for spec-led rows."
          },
          {
            "title": "Can this support accessories?",
            "text": "Yes. Add accessory product rows and related product sections."
          },
          {
            "title": "Is checkout protected?",
            "text": "Trust badges and secure checkout messaging are built into the layout."
          }
        ]
      }
    ]
  },
  "demoContent": {
    "announcementText": "Limited tech deals live now. Upgrade your setup today.",
    "heroSlides": [
      {
        "eyebrow": "Upgrade Season",
        "title": "Power Your Setup With Smarter Gear",
        "subtitle": "Devices, accessories, and essentials for work, play, and home.",
        "buttonText": "Shop Tech",
        "buttonLink": "/products",
        "secondaryButtonText": "View Deals",
        "secondaryButtonLink": "/products?onSale=true",
        "image": "https://images.unsplash.com/photo-1498049794561-7780e7231661?auto=format&fit=crop&w=1800&q=80",
        "position": "center",
        "color": "#ffffff"
      },
      {
        "eyebrow": "New Launches",
        "title": "Latest Devices. Faster Decisions.",
        "subtitle": "A specs-friendly storefront for electronics and accessories.",
        "buttonText": "See Launches",
        "buttonLink": "/products?sort=newest",
        "image": "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=1800&q=80",
        "position": "center",
        "color": "#ffffff"
      }
    ],
    "valueProps": [
      {
        "icon": "verified",
        "title": "Warranty Ready",
        "text": "Trusted product support"
      },
      {
        "icon": "shipping",
        "title": "Fast Dispatch",
        "text": "Ships securely"
      },
      {
        "icon": "secure",
        "title": "Secure Checkout",
        "text": "Protected payments"
      },
      {
        "icon": "support",
        "title": "Tech Support",
        "text": "Help before purchase"
      }
    ],
    "promoBanners": [
      {
        "kicker": "Hot Deal",
        "title": "Setup Upgrade Event",
        "subtitle": "Save on gadgets, accessories, and work gear.",
        "ctaText": "Shop Deals",
        "link": "/products?onSale=true",
        "color": "#0f172a",
        "accentColor": "#06b6d4"
      },
      {
        "kicker": "New",
        "title": "Fresh Tech Drops",
        "subtitle": "Latest launches ready for early adopters.",
        "ctaText": "Explore New",
        "link": "/products?sort=newest",
        "color": "#172554",
        "accentColor": "#60a5fa"
      }
    ]
  },
  "capabilities": {
    "design": true,
    "layoutStyle": true,
    "homepageSections": true,
    "demoContent": true,
    "pageTemplates": true,
    "dataSources": true,
    "customCode": false,
    "componentStyles": true,
    "sectionPresets": true
  },
  "dataSources": [
    {
      "key": "featured-products",
      "type": "apiBuilder",
      "definition": {
        "name": "Tech Pro Featured Products",
        "description": "Template-owned storefront endpoint for Tech Pro product rows.",
        "isActive": true,
        "config": {
          "responseMode": "object",
          "includeMeta": true,
          "blocks": [
            {
              "key": "products",
              "resource": "products",
              "enabled": true,
              "mode": "filtered",
              "limit": 8,
              "fields": [
                "id",
                "name",
                "slug",
                "shortDescription",
                "price",
                "salePrice",
                "saleLabel",
                "avgRating",
                "reviewCount",
                "brandId",
                "createdAt"
              ],
              "filters": [
                {
                  "field": "isFeatured",
                  "operator": "equals",
                  "source": "static",
                  "value": true
                }
              ],
              "relations": [
                {
                  "key": "images",
                  "relation": "images",
                  "resource": "productImages",
                  "enabled": true,
                  "mode": "all",
                  "limit": 1,
                  "fields": [
                    "url",
                    "alt",
                    "isPrimary",
                    "sortOrder"
                  ],
                  "sortBy": "sortOrder",
                  "sortOrder": "ASC"
                }
              ],
              "sortBy": "createdAt",
              "sortOrder": "DESC"
            }
          ]
        }
      }
    }
  ],
  "pageTemplates": {
    "product": {
      "layout": "specs-first",
      "showTrustBadges": true,
      "showRelatedProducts": true,
      "showRecentlyViewed": true,
      "showStickyAddToCart": true,
      "showBreadcrumbs": true
    },
    "collection": {
      "layout": "sidebar-filters-grid",
      "productsPerRow": 4,
      "filterLayout": "sidebar",
      "showBreadcrumbs": true
    }
  },
  "componentStyles": {
    "productCard": {
      "variant": "marketplace",
      "imageRatio": "1/1",
      "imageFit": "contain",
      "showBrand": true,
      "showCategory": true,
      "showRating": true,
      "showWishlist": true,
      "showSaleCountdown": true,
      "priceStyle": "bold",
      "badgeStyle": "corner",
      "badgePosition": "top-left",
      "hoverEffect": "lift",
      "radius": "medium",
      "shadow": "medium",
      "density": "comfortable"
    },
    "categoryCard": {
      "variant": "icon-grid",
      "imageRatio": "1/1",
      "imageFit": "contain",
      "titlePlacement": "below",
      "showSubtitle": false,
      "showProductCount": true,
      "hoverEffect": "lift",
      "radius": "medium",
      "shadow": "soft",
      "density": "compact"
    },
    "promoCard": {
      "variant": "banner-stack",
      "imagePlacement": "right",
      "titleSize": "medium",
      "ctaStyle": "button",
      "radius": "medium",
      "shadow": "medium"
    },
    "brandCard": {
      "variant": "logo-card",
      "hoverEffect": "lift",
      "radius": "medium",
      "shadow": "soft"
    },
    "trustCard": {
      "variant": "icon-row",
      "titleSize": "small",
      "radius": "medium",
      "shadow": "none"
    }
  },
